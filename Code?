const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

const SUPPORT_VALUES = {
  none: { mt: 0, hit: 0, crit: 0, avoid: 0 },
  C:    { mt: 0, hit: 5, crit: 5, avoid: 5 },
  B:    { mt: 0, hit: 10, crit: 10, avoid: 10 },
  A:    { mt: 0, hit: 15, crit: 15, avoid: 15 }
};

const RANK_VALUES = {
  E: { hit: 0, crit: 0 },
  D: { hit: 0, crit: 0 },
  C: { hit: 0, crit: 0 },
  B: { hit: 2, crit: 0 },
  A: { hit: 3, crit: 3 },
  S: { hit: 5, crit: 5 }
};

const getTri = (t1, t2) => {
  if (
    (t1 === 'Sword' && t2 === 'Axe') ||
    (t1 === 'Axe' && t2 === 'Lance') ||
    (t1 === 'Lance' && t2 === 'Sword')
  ) {
    return { mt: 1, hit: 15 };
  }

  if (
    (t1 === 'Axe' && t2 === 'Sword') ||
    (t1 === 'Lance' && t2 === 'Axe') ||
    (t1 === 'Sword' && t2 === 'Lance')
  ) {
    return { mt: -1, hit: -15 };
  }

  return { mt: 0, hit: 0 };
};

function getFC(a, b) {
  const atkWeapon = a.wpn ?? a.weapon;
  const defWeapon = b.wpn ?? b.weapon;

  const supportAtk = SUPPORT_VALUES[a.support ?? 'none'] ?? SUPPORT_VALUES.none;
  const supportDef = SUPPORT_VALUES[b.support ?? 'none'] ?? SUPPORT_VALUES.none;

  const rankAtk = RANK_VALUES[a.rank ?? 'E'] ?? RANK_VALUES.E;
  const tri = getTri(atkWeapon.type, defWeapon.type);

  const baseMt = a.effective ? atkWeapon.mt * 3 : atkWeapon.mt;
  const effectiveAtk = a.pow + baseMt + tri.mt + supportAtk.mt;

  const defenseStat = (atkWeapon.dmgType === 'Mag' ? b.res : b.def) + (b.terrain === 'Fort' ? 2 : 0);

  const atkSpeed = a.spd - Math.max(0, atkWeapon.wt - a.con);
  const defSpeed = b.spd - Math.max(0, defWeapon.wt - b.con);

  const rawHit =
    atkWeapon.hit +
    a.skl * 2 +
    Math.floor(a.lck / 2) +
    tri.hit +
    supportAtk.hit +
    rankAtk.hit;

  const terrainAvoid =
    (b.terrain === 'Forest' || b.terrain === 'Fort' ? 20 : 0) +
    supportDef.avoid;

  const avoid = defSpeed * 2 + b.lck + terrainAvoid;

  const critChance =
    atkWeapon.crit +
    Math.floor(a.skl / 2) +
    supportAtk.crit +
    (a.critClass ? 15 : 0) +
    rankAtk.crit -
    b.lck -
    supportDef.crit;

  return {
    as: atkSpeed,
    dmg: Math.max(0, effectiveAtk - defenseStat),
    hit: clamp(rawHit - avoid, 0, 100),
    crit: clamp(critChance, 0, 100),
    dbl: false
  };
}

function runSim(u1, u2, mode = 'Classic', use2RN = true) {
  const log = [];
  let hp1 = u1.hp;
  let hp2 = u2.hp;
  let round = 1;

  const f1 = getFC(u1, u2);
  const f2 = getFC(u2, u1);

  f1.dbl = (f1.as - f2.as >= 4);
  f2.dbl = (f2.as - f1.as >= 4);

  log.push(`[START] ${u1.name} (${hp1} HP) vs ${u2.name} (${hp2} HP}`);

  const roll = (threshold) => {
    let r = Math.random() * 100;
    if (use2RN) r = (r + Math.random() * 100) / 2;
    return r < threshold;
  };

  const strike = (attacker, combat, defender, defenderName, label = 'attacks') => {
    if (defender.hp <= 0) return true;

    log.push(`• ${attacker.name} ${label}...`);

    if (roll(combat.hit)) {
      const crit = roll(combat.crit);
      const dmg = crit ? combat.dmg * 3 : combat.dmg;

      defender.hp = Math.max(0, defender.hp - dmg);

      log.push(
        crit
          ? `✨ CRITICAL! ${attacker.name} deals ${dmg} damage to ${defenderName}!`
          : `💥 Hit! ${attacker.name} deals ${dmg} damage to ${defenderName}.`
      );
      log.push(` STATUS: ${defenderName} HP is now [${defender.hp}]`);
    } else {
      log.push(`💨 Miss! ${attacker.name} missed.`);
    }

    return defender.hp <= 0;
  };

  const o1 = { hp: hp1, name: u1.name };
  const o2 = { hp: hp2, name: u2.name };

  while (o1.hp > 0 && o2.hp > 0) {
    log.push(`--- Round ${round} ---`);

    if (strike(u1, f1, o2, u2.name)) break;
    if (strike(u2, f2, o1, u1.name)) break;

    if (f1.dbl && strike(u1, f1, o2, u2.name, 'doubles')) break;
    if (f2.dbl && strike(u2, f2, o1, u1.name, 'doubles')) break;

    if (mode === 'Classic') break;
    round += 1;
    if (round > 50) break;
  }

  if (o1.hp <= 0 && o2.hp <= 0) {
    log.push(`🛡️ DRAW: both combatants fell in the same round.`);
  } else if (o1.hp <= 0) {
    log.push(`💀 VICTORY: ${u2.name} has won!`);
  } else if (o2.hp <= 0) {
    log.push(`🏆 VICTORY: ${u1.name} has won!`);
  } else {
    log.push(`🛡️ END: Match concluded with both surviving.`);
  }

  return log.join('\n');
}
